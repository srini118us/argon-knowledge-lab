    "DR-1": {
      "doc": "DRS-01@v1",
      "text": "C2 or higher about EU data subjects processed only in the EU region"
    },
    "NZ-2": {
      "doc": "NET-STD@v2",
      "text": "egress from zone Z3 must pass the egress proxy"
    },
    "D1": {
      "doc": "ADR-031@v1",
      "text": "vendor integrations route through int-gw"
    },
    "CF-1": {
      "doc": "CHG-CAL@2026",
      "text": "go live inside a freeze window is approved only on condition it moves outside the window"
    }

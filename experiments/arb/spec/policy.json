    "SP-4.2": {
      "doc": "SEC-POL@v3",
      "text": "C2 or higher encrypted at rest at the vendor"
    },
    "AX-EU-1": {
      "doc": "AX-EU@v1",
      "text": "EU data subjects: C2 or higher retained at most 14 days; replaces SP-4.1 for that data",
